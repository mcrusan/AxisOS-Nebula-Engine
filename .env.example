# Nebius Token Factory & Nebius AI Cloud Configuration
NEBIUS_API_KEY=your_nebius_token_factory_api_key_here
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1
NEBIUS_SERVERLESS_ENDPOINT=https://serverless.nebius.ai/v1/axisos-nebula

# NVIDIA Open-Source Model Tiers on Nebius Token Factory
NVIDIA_MODEL_NANO=nvidia/Llama-3_1-Nemotron-Nano-8B-v1
NVIDIA_MODEL_SUPER=nvidia/Llama-3_3-Nemotron-Super-49B-v1
NVIDIA_MODEL_ULTRA=nvidia/Llama-3_1-Nemotron-Ultra-253B-v1

# AxisOS Sovereign Triad Edge & Cloud Run Outpost Endpoints
AXISOS_ZERO_CORE_URL=http://192.168.1.34:8081
AXISOS_LITE_URL=http://192.168.1.34:8080
AXISOS_AGENT_URL=http://192.168.1.34:8082
AXISOS_COMMS_URL=http://192.168.1.34:8085
AXISOS_CLOUD_OUTPOST_URL=https://axisos-sovereign-triad-4zye7tn3qq-uw.a.run.app

# Runtime Settings
APP_ENV=production
APP_PORT=8090
LOG_LEVEL=INFO
